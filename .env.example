# Leave blank during local Vite development to use the built-in /api proxy.
# Set this to your deployed backend URL for production builds if needed.
VITE_API_BASE_URL=

# Optional LAN-IP fallback used when /api/ip-service/my-ip is reached through a local proxy and returns ::1.
VITE_CLIENT_IP=

# Existing scanner web application embedded in the IP Service scan page.
VITE_SCANNER_APP_URL=http://10.31.3.114:5001
